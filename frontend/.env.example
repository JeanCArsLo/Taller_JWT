# Copia este archivo como ".env" en la carpeta frontend/ solo si necesitas
# apuntar a un backend distinto del proxy local (por ejemplo, en producción).

# URL pública del backend desplegado en Render.
# En desarrollo local puedes dejarla vacía: se usa el proxy de vite.config.js.
VITE_API_URL=https://tu-backend.onrender.com
