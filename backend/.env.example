# Copia este archivo como ".env" en la carpeta backend/ y completa los valores.
# El archivo ".env" real NUNCA se sube a git (ver .gitignore).

# ── Base de datos ────────────────────────────────────────────
# Local:  mongodb://localhost:27017/jwt-practica
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/jwt-practica
MONGO_URL=mongodb://localhost:27017/jwt-practica

# ── JWT ───────────────────────────────────────────────────────
# Cadena larga y aleatoria para firmar los tokens. Cámbiala en producción.
JWT_SECRET=esta_es_mi_clave_secreta_cambiar_en_produccion_123

# ── Sesión (usada internamente por Passport durante el login con Google) ──
SESSION_SECRET=otra_clave_larga_y_aleatoria_para_las_sesiones

# ── Google OAuth 2.0 ─────────────────────────────────────────
# Se obtienen en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── URLs de front y puerto ───────────────────────────────────
# A dónde redirigir tras el login con Google y qué origen permitir en CORS.
FRONTEND_URL=http://localhost:5173

# Puerto del servidor. Render/Heroku lo asignan automáticamente en runtime,
# así que en producción esta variable no hace falta configurarla.
PORT=4000
